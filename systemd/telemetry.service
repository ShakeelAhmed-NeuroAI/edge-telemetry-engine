[Unit]
Description=Edge-Native Python Telemetry Engine Daemon
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/edge-telemetry-engine
ExecStart=/opt/edge-telemetry-engine/venv/bin/python main.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target